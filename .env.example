# =============================================
# CMS — Environment Variables Template
# Copy this to .env.local and fill in values
# =============================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Neon Postgres)
DATABASE_URL="postgresql://username:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://username:password@host/dbname?sslmode=require"

# Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app/dashboard

# Token Encryption (32-byte hex string)
TOKEN_ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here_replace_me

# Meta / Instagram OAuth
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_REDIRECT_URI=http://localhost:3000/api/social/instagram/callback

# TikTok OAuth
TIKTOK_APP_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/social/tiktok/callback
TIKTOK_DIRECT_POST_ENABLED=false

# File Storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Queue (Inngest)
INNGEST_EVENT_KEY=local
INNGEST_SIGNING_KEY=

# Monitoring (Sentry)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Email (Resend)
RESEND_API_KEY=

# Cron secret (to protect cron endpoints)
CRON_SECRET=your_random_cron_secret_here

# Mock mode (keep "false" for real publishing)
NEXT_PUBLIC_MOCK_PUBLISHING=false
